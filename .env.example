# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application URL
# For local development, use http://localhost:3000
# For production, use your actual domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database URL (Required for Drizzle ORM)
# This is your Supabase PostgreSQL connection string
# Get from: Project Settings > Database > Connection string > URI
# Format: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=your_supabase_database_url

# Legacy: Supabase Project ID (now optional, used for reference)
PROJECT_ID=your_supabase_project_id

# Optional: Google Site Verification (for SEO)
GOOGLE_SITE_VERIFICATION=